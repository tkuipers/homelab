# Talos-specific ignores
talosconfig
*.key
*.crt

# Helm-specific ignores
charts/
*.tgz

# General ignores
.DS_Store
.vscode/ 

**/*.kubeconfig
**/*.txt
kubeconfig**
talosconfig**

# Cluster configs directory (generated by setup script)
cluster-configs/

# Ignore credential files but allow:
# - YAML files referencing credentials (ExternalSecrets etc)
# - Setup scripts for credentials
**credentials**
!**credentials**.yaml
!**/setup-credentials/
!**setup**credentials**.sh
tooling/scripts/setup-credentials/setup-stocks-credentials.local.inc.sh
op.sig
