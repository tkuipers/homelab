{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "automerge": false,
      "versioning": "regex:^(?<major>\\w+)$",
      "matchPackageNames": [
        "/^ghcr.io/tkuipers//"
      ]
    },
    {
      "description": "Authelia guards every app: merge its patch releases automatically (after 3 days, in case a release is pulled). Minor/major still come as PRs because they can need config changes.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "authelia/authelia"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "ignoreTests": true
    }
  ],
  "hostRules": [
    {
      "matchHost": "ghcr.io",
      "hostType": "docker",
      "username": "tkuipers",
      "password": "{{ secrets.GHCR_TOKEN }}"
    }
  ]
}
