{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "automerge": false,
      "versioning": "regex:^(?<major>\\w+)$",
      "matchPackageNames": [
        "/^ghcr.io/tkuipers//"
      ]
    }
  ],
  "hostRules": [
    {
      "matchHost": "ghcr.io",
      "hostType": "docker",
      "username": "tkuipers",
      "password": "{{ secrets.GHCR_TOKEN }}"
    }
  ]
}
