   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(increase(kube_pod_container_status_restarts_total{namespace=\"mediacenter\", pod=~\"transmission-[a-z0-9]{6,10}-[a-z0-9]{5}\"}[24h]))) or vector(-1)",
