{
 "description": "Home dashboard: is the platform green? Every tile is a count of failing things (OK = 0). For details go to Homelab overview or the service dashboards.",
 "editable": true,
 "graphTooltip": 1,
 "links": [
  {
   "icon": "dashboard",
   "keepTime": true,
   "title": "Homelab overview",
   "type": "link",
   "url": "/d/homelab-overview"
  },
  {
   "asDropdown": true,
   "includeVars": false,
   "keepTime": true,
   "tags": [
    "service"
   ],
   "title": "Services",
   "type": "dashboards"
  },
  {
   "icon": "doc",
   "targetBlank": true,
   "title": "Explore logs",
   "type": "link",
   "url": "/a/grafana-lokiexplore-app/explore"
  }
 ],
 "panels": [
  {
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "number of the areas below that are not OK",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "options": {
        "0": {
         "color": "green",
         "text": "ALL GREEN"
        }
       },
       "type": "value"
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "unit": "suffix: area(s) need attention"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 5,
    "w": 16,
    "x": 0,
    "y": 0
   },
   "id": 1,
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "clamp_max((count(probe_success{probe=\"internal\"} == 0)) or vector(0), 1) + clamp_max((count(probe_success{probe=\"external\"} == 0)) or vector(0), 1) + clamp_max(((count(kube_deployment_status_replicas_available - kube_deployment_spec_replicas < 0) or vector(0)) + (count(kube_statefulset_status_replicas_ready - kube_statefulset_replicas < 0) or vector(0)) + (count(kube_daemonset_status_number_ready - kube_daemonset_status_desired_number_scheduled < 0) or vector(0)) + (count(kube_pod_container_status_waiting_reason{reason=~\"CrashLoopBackOff|ImagePullBackOff|ErrImagePull|CreateContainerConfigError\"}) or vector(0))) or vector(0), 1) + clamp_max(((count(kube_node_status_condition{condition=\"Ready\", status=\"true\"} == 0) or vector(0)) + (count(kube_node_status_condition{condition=~\"MemoryPressure|DiskPressure|PIDPressure\", status=\"true\"} == 1) or vector(0))) or vector(0), 1) + clamp_max((count(max by (instance, mountpoint) (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs\"}) > 0.85)) or vector(0), 1) + clamp_max((count(min by (instance) (probe_ssl_earliest_cert_expiry - time()) < 14 * 86400) + (count(certmanager_certificate_ready_status{condition=\"False\"} == 1) or vector(0))) or vector(0), 1) + clamp_max((count(((time() - max by (namespace, cronjob) (kube_cronjob_status_last_successful_time)) - 2 * (max by (namespace, cronjob) (kube_cronjob_next_schedule_time) - max by (namespace, cronjob) (kube_cronjob_status_last_schedule_time)) - 1800) > 0 unless on (namespace, cronjob) (kube_cronjob_spec_suspend == 1)) + (count(max by (namespace, job_name) (kube_job_status_failed > 0) and on (namespace, job_name) (time() - kube_job_status_start_time < 86400)) or vector(0))) or vector(0), 1) + clamp_max((count(argocd_app_info{sync_status!=\"Synced\"} or argocd_app_info{health_status!=\"Healthy\"})) or vector(0), 1) + clamp_max((count(externalsecret_status_condition{condition=\"Ready\", status=\"False\"} == 1)) or vector(0), 1) + clamp_max(((count(up == 0) or vector(0)) + (sum(rate(otelcol_exporter_sent_log_records_total{component_id=\"otelcol.exporter.otlphttp.loki\"}[5m])) < bool 0.01 or vector(1)) + (sum(rate(grafana_alerting_rule_evaluations_total[10m])) < bool 0.001 or vector(1))) or vector(0), 1)",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "A"
    }
   ],
   "title": "Platform status",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Grafana-managed + Prometheus alerts currently firing (list below)",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "options": {
        "0": {
         "color": "green",
         "text": "OK"
        }
       },
       "type": "value"
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 10
       }
      ]
     },
     "unit": "short"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 5,
    "w": 8,
    "x": 16,
    "y": 0
   },
   "id": 2,
