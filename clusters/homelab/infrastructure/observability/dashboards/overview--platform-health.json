    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(count(ALERTS{alertstate=\"firing\", alertname!~\"Watchdog|InfoInhibitor\"}) or vector(0)) + (sum(grafana_alerting_alerts{state=\"alerting\"}) or vector(0))",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "A"
    }
