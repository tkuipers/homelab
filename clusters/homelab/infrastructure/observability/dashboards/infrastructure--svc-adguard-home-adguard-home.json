    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(increase(kube_pod_container_status_restarts_total{namespace=\"adguard-home\", pod=~\"adguard-home-[a-z0-9]{6,10}-[a-z0-9]{5}\"}[24h]))) or vector(-1)",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "A"
    }
   ],
   "title": "Restarts (24h)",
