     "expr": "(sum(kube_pod_container_status_last_terminated_reason{namespace=\"adguard-home\", pod=~\"adguard-home-[a-z0-9]{6,10}-[a-z0-9]{5}\", reason=\"OOMKilled\"}) or (count(kube_pod_container_info{namespace=\"adguard-home\", pod=~\"adguard-home-[a-z0-9]{6,10}-[a-z0-9]{5}\"}) * 0)) or vector(-1)",
     "instant": true,
