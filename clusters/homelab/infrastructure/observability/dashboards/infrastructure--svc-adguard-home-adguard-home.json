  {
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "available / desired replicas",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "options": {
        "-1": {
         "color": "blue",
         "text": "scaled to 0"
        }
       },
       "type": "value"
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.5
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "unit": "percentunit"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "id": 2,
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(kube_deployment_status_replicas_available{namespace=\"adguard-home\", deployment=\"adguard-home\"}) / (sum(kube_deployment_spec_replicas{namespace=\"adguard-home\", deployment=\"adguard-home\"}) > 0)) or (sum(kube_deployment_spec_replicas{namespace=\"adguard-home\", deployment=\"adguard-home\"}) * 0 - 1)",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "A"
    }
   ],
   "title": "Ready replicas",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "decimals": 0,
     "mappings": [
      {
       "options": {
        "-1": {
         "color": "text",
         "text": "no pods"
        }
       },
       "type": "value"
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 10
       }
      ]
