      "type": "loki",
      "uid": "loki"
     },
     "expr": "(sum(count_over_time({k8s_namespace_name=\"adguard-home\", service_name=\"adguard-home\"} | detected_level=~\"error|fatal|critical\" [1h])) or (sum(count_over_time({k8s_namespace_name=\"adguard-home\", service_name=\"adguard-home\"} [1h])) * 0)) or (vector(0) - 1)",
     "legendFormat": "",
     "queryType": "instant",
     "refId": "A"
    }
   ],
