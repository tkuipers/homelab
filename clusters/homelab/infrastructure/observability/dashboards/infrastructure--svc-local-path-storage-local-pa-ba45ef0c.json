     "expr": "sum(kube_pod_container_status_last_terminated_reason{namespace=\"local-path-storage\", pod=~\"local-path-provisioner-[a-z0-9]{6,10}-[a-z0-9]{5}\", reason=\"OOMKilled\"}) or vector(0)",
     "instant": true,
     "legendFormat": "__auto",
