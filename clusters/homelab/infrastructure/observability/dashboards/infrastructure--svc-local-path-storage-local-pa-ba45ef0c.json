    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(count_over_time({k8s_namespace_name=\"local-path-storage\", service_name=\"local-path-provisioner\"} | detected_level=~\"error|fatal|critical\" [1h])) or vector(0)",
     "legendFormat": "",
     "queryType": "instant",
     "refId": "A"
    }
   ],
   "title": "Error logs (1h)",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
