  {
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "description": "log lines per interval, split by detected level",
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 80,
      "lineWidth": 1,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "group": "A",
       "mode": "normal"
      }
     },
     "min": 0,
     "unit": "short"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "fatal"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "fixedColor": "dark-red",
         "mode": "fixed"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "critical"
      },
      "properties": [
       {
