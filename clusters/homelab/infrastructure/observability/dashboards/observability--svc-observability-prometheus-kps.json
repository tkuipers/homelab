    "textMode": "auto"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(increase(kube_pod_container_status_restarts_total{namespace=\"observability\", pod=~\"prometheus-kps-[0-9]+\"}[24h]))) or vector(-1)",
