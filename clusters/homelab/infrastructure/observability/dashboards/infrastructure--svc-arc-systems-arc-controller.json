{
 "description": "Self-hosted runners (runs-on: homelab): controller + one listener per scale set in arc-systems, a pod per job in arc-runners. clusters/homelab/infrastructure/github-runners",
 "editable": true,
 "graphTooltip": 1,
 "links": [
  {
   "icon": "dashboard",
   "keepTime": true,
   "title": "Homelab overview",
   "type": "link",
   "url": "/d/homelab-overview"
  },
  {
   "asDropdown": true,
   "includeVars": false,
   "keepTime": true,
   "tags": [
    "service"
   ],
   "title": "Services",
   "type": "dashboards"
  },
  {
   "icon": "doc",
   "targetBlank": true,
   "title": "Explore logs",
   "type": "link",
   "url": "/a/grafana-lokiexplore-app/explore"
  }
 ],
 "panels": [
  {
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "id": 1,
   "panels": [],
   "title": "Status",
   "type": "row"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "available / desired replicas",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "options": {
        "-1": {
         "color": "blue",
         "text": "scaled to 0"
        }
       },
       "type": "value"
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.5
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "unit": "percentunit"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "id": 2,
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(kube_deployment_status_replicas_available{namespace=\"arc-systems\", deployment=\"arc-controller\"}) / (sum(kube_deployment_spec_replicas{namespace=\"arc-systems\", deployment=\"arc-controller\"}) > 0)) or (sum(kube_deployment_spec_replicas{namespace=\"arc-systems\", deployment=\"arc-controller\"}) * 0 - 1)",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "A"
    }
   ],
   "title": "Ready replicas",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "decimals": 0,
     "mappings": [
      {
       "options": {
        "-1": {
         "color": "text",
         "text": "no pods"
        }
       },
       "type": "value"
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 10
       }
      ]
     },
     "unit": "short"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 1
   },
   "id": 3,
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(increase(kube_pod_container_status_restarts_total{namespace=\"arc-systems\", pod=~\"arc-controller-[a-z0-9]{6,10}-[a-z0-9]{5}\"}[24h]))) or vector(-1)",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "A"
    }
   ],
   "title": "Restarts (24h)",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "description": "log lines at error level or worse in the last hour ('no logs' = the service logged nothing at all)",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "options": {
        "-1": {
         "color": "text",
         "text": "no logs (1h)"
        }
       },
       "type": "value"
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 50
       }
      ]
     },
     "unit": "short"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 1
   },
   "id": 4,
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "(sum(count_over_time({k8s_namespace_name=\"arc-systems\", service_name=\"arc-controller\"} | detected_level=~\"error|fatal|critical\" [1h])) or (sum(count_over_time({k8s_namespace_name=\"arc-systems\", service_name=\"arc-controller\"} [1h])) * 0)) or (vector(0) - 1)",
     "legendFormat": "",
     "queryType": "instant",
     "refId": "A"
    }
   ],
   "title": "Error logs (1h)",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "containers whose last termination was an OOM kill",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "options": {
        "-1": {
         "color": "text",
         "text": "no pods"
        }
       },
       "type": "value"
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "unit": "short"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 1
   },
   "id": 5,
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(kube_pod_container_status_last_terminated_reason{namespace=\"arc-systems\", pod=~\"arc-controller-[a-z0-9]{6,10}-[a-z0-9]{5}\", reason=\"OOMKilled\"}) or (count(kube_pod_container_info{namespace=\"arc-systems\", pod=~\"arc-controller-[a-z0-9]{6,10}-[a-z0-9]{5}\"}) * 0)) or vector(-1)",
     "instant": true,
     "legendFormat": "__auto",
     "range": false,
     "refId": "A"
    }
   ],
   "title": "OOMKilled (last termination)",
   "type": "stat"
  },
  {
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 5
   },
   "id": 6,
   "panels": [],
   "title": "Failures",
   "type": "row"
  },
  {
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "description": "log lines per interval, split by detected level",
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 80,
      "lineWidth": 1,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "group": "A",
       "mode": "normal"
      }
     },
     "min": 0,
     "unit": "short"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "fatal"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "fixedColor": "dark-red",
         "mode": "fixed"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "critical"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "fixedColor": "dark-red",
         "mode": "fixed"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "error"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "fixedColor": "red",
         "mode": "fixed"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "warn"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "fixedColor": "orange",
         "mode": "fixed"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "info"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "fixedColor": "green",
         "mode": "fixed"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "debug"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "fixedColor": "blue",
         "mode": "fixed"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "trace"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "fixedColor": "purple",
         "mode": "fixed"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "unknown"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "fixedColor": "text",
         "mode": "fixed"
        }
       }
      ]
     }
    ]
   },
   "gridPos": {
