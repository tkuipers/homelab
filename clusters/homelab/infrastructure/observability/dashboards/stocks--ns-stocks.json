    "cellHeight": "sm",
    "showHeader": true
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (deployment) (kube_deployment_status_replicas_available{namespace=\"stocks\"})",
     "format": "table",
     "instant": true,
     "legendFormat": "ready",
     "range": false,
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (deployment) (kube_deployment_spec_replicas{namespace=\"stocks\"})",
     "format": "table",
     "instant": true,
     "legendFormat": "desired",
     "range": false,
     "refId": "B"
    }
   ],
   "title": "Workload readiness",
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value #A": "ready",
       "Value #B": "desired"
      }
     }
    }
   ],
   "type": "table"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "",
