// =============================================================================
// TEMPORARY one-off backfill (2026-10-11). Remove this file (and its line in
// templates/config.yaml) once it has run.
//
// Re-reads every pod log file with its own checkpoints and ships the lines
// written before the live pipeline took over (2026-10-11T05:14:00Z) and less
// than 29d old (Loki rejects >30d). History goes to separate streams
// (index label log_origin="backfill-<restart count>") so it can't collide
// with the live streams' out-of-order window, and the two files a
// restarted container has (N-1.log, N.log) don't collide with each other.
// Dashboards select on namespace/service_name, so they see both.
// =============================================================================

otelcol.storage.file "backfill" {
	directory = "/var/lib/alloy/storage-backfill-3"
}

otelcol.receiver.filelog "backfill" {
	include           = ["/var/log/pods/*/*/*.log"]
	start_at          = "beginning"
	include_file_path = true
	max_log_size      = "1MiB"
	storage           = otelcol.storage.file.backfill.handler

	operators = [
		{type = "container", add_metadata_from_filepath = true},
		{
			type               = "recombine",
			combine_field      = "body",
			source_identifier  = `attributes["log.file.path"]`,
			is_first_entry     = `body matches "^\\S" and not (body matches "^(Traceback |During handling|The above exception|[A-Za-z_][\\w.]*(Error|Exception|Warning)(: |$)|Caused by:)")`,
			combine_with       = "\n",
			max_log_lines      = 500,
			force_flush_period = "1s",
		},
		{type = "remove", field = `attributes["log.file.path"]`},
		{type = "remove", field = `attributes["log.file.name"]`},
		{type = "remove", field = `attributes["logtag"]`},
	]

	output {
		logs = [otelcol.processor.filter.backfill.input]
	}
}

otelcol.processor.filter "backfill" {
	error_mode = "ignore"

	logs {
		log_record = [
			`time_unix_nano >= 1791695640000000000`,
			`time_unix_nano < UnixNano(Now()) - 2505600000000000`,
		]
	}

	output {
		logs = [otelcol.processor.transform.backfill.input]
	}
}

otelcol.processor.transform "backfill" {
	error_mode = "ignore"

	log_statements {
		context    = "resource"
		statements = [
			`set(attributes["log.origin"], Concat(["backfill-", attributes["k8s.container.restart_count"]], ""))`,
		]
	}

	output {
		logs = [otelcol.processor.k8sattributes.default.input]
	}
}
