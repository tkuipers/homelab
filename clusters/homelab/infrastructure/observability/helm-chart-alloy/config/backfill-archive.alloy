// =============================================================================
// TEMPORARY one-off archive backfill (2026-10-11). Remove this file (and its
// line in templates/config.yaml) once it has run.
//
// Ships container log lines written before 2026-09-12T06:00Z (everything
// newer is already in Loki) into log_origin="backfill-archive-<restart>"
// streams, which Loki keeps for 400d (retention_stream). Quiet containers
// whose newest line is months old thereby still have their logs in Loki.
// =============================================================================

otelcol.storage.file "archive" {
	directory = "/var/lib/alloy/storage-archive"
}

otelcol.receiver.filelog "archive" {
	include           = ["/var/log/pods/*/*/*.log"]
	start_at          = "beginning"
	include_file_path = true
	max_log_size      = "1MiB"
	storage           = otelcol.storage.file.archive.handler

	operators = [
		{type = "container", add_metadata_from_filepath = true},
		{
			type               = "recombine",
			combine_field      = "body",
			source_identifier  = `attributes["log.file.path"]`,
			is_first_entry     = `body matches "^\\S" and not (body matches "^(Traceback |During handling|The above exception|[A-Za-z_][\\w.]*(Error|Exception|Warning)(: |$)|Caused by:|no A{1,4} record resolved)")`,
			combine_with       = "\n",
			max_log_lines      = 500,
			force_flush_period = "1s",
		},
		{type = "remove", field = `attributes["log.file.path"]`},
		{type = "remove", field = `attributes["log.file.name"]`},
		{type = "remove", field = `attributes["logtag"]`},
	]

	output {
		logs = [otelcol.processor.filter.archive.input]
	}
}

otelcol.processor.filter "archive" {
	error_mode = "ignore"

	logs {
		log_record = [`time_unix_nano >= 1789192800000000000`]
	}

	output {
		logs = [otelcol.processor.transform.archive.input]
	}
}

otelcol.processor.transform "archive" {
	error_mode = "ignore"

	log_statements {
		context    = "resource"
		statements = [
			`set(attributes["log.origin"], Concat(["backfill-archive-", attributes["k8s.container.restart_count"]], ""))`,
		]
	}

	output {
		logs = [otelcol.processor.k8sattributes.default.input]
	}
}
